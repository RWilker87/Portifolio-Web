*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Operating System Files
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
